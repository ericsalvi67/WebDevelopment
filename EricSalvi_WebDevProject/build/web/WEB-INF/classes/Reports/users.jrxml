	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="db_webdev"/>
	<queryString>
		<![CDATA[select
    u.email,
    u.created_at,
    case
        when u.role = 1 then 'Administrador'
        else 'Usuário'
    end as perfil,
    p.total_projetos,
    r.total_requisitos
from users u
left join lateral (
    select count(*) as total_projetos
    from projects p
    where p.created_by = u.email
) p on true
left join lateral (
   select count(*) as total_requisitos
     from requirements r
    inner join projects p 
       on p.id = r.project_id
    where p.created_by = u.email
) r on true;]]>
	</queryString>
	<field name="email" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="cliente"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="cliente"/>
	</field>
	<field name="created_At" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.label" value="data"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="pedido"/>
	</field>
	<field name="perfil" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="produto"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="produto"/>
	</field>
	<field name="total_projetos" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="qtde"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="item_pedido"/>
	</field>
	<field name="total_requisitos" class="java.lang.Integer"/>
