	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="db_webdev"/>
	<parameter name="project_id" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
			    p.name         AS projeto,
			    p.created_by   AS email_criador,
			    p.created_at   AS data_criacao,
			    r.code         AS codigo_requisito,
			    r.version      AS versao,
			    r.requirement  AS requisito,
			    r.description  AS descricao,
			    r.priority     AS prioridade,
			    r.complexity   AS complexidade
			FROM public.projects p
			JOIN public.requirements r ON r.project_id = p.id
			WHERE p.id = '$P!{project_id}'
			ORDER BY r.code, r.version]]>
	</queryString>
